package lt.vytzab.engine;

// Local settings for the engine. Copy this file to Variables.java (git-ignored) and fill it in.
// The database login is asked for when the engine starts, so it is never stored here.
public class Variables {
    /** MariaDB database holding the markets and orders. */
    public static final String JDBC_URL = "jdbc:mariadb://localhost:3306/fix";
    /** Polygon.io API key, used to fill empty markets with the previous day's prices. */
    private static final String API_KEY = "your-polygon-api-key";

    private static String username;
    private static String password;

    public static String getApiKey() { return API_KEY; }
    public static String getUsername() { return username; }
    public static void setUsername(String value) { username = value; }
    public static String getPassword() { return password; }
    public static void setPassword(String value) { password = value; }
}
